# Paddle — client-side (safe to expose in the browser bundle)
# 'live' or 'sandbox'. Required: the app fails loudly if this is unset.
VITE_PADDLE_ENVIRONMENT=live
# Client-side token from Paddle → Developer tools → Authentication.
# Must start with live_ when VITE_PADDLE_ENVIRONMENT=live.
VITE_PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxx

# Paddle server-side API key — server only, NEVER referenced in client code.
# Not required by the pricing page (PricePreview + Checkout are client-side),
# only add it if you build webhook/subscription-management server functions.
# PADDLE_API_KEY=
