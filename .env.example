# Paddle environment — 'live' or 'sandbox'. Required (the app refuses to guess).
PADDLE_ENVIRONMENT=sandbox

# Public client-side token. Must start with live_ on live, test_ on sandbox.
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Webhook (server only — NEVER expose to the client) ──
PADDLE_API_KEY=
# Paddle → Developer tools → Notifications → your destination → secret key
PADDLE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Make.com scenario webhook used by /api/upload (was hard-coded; rotate the old one)
MAKE_WEBHOOK_URL=
