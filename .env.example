# Paddle environment — 'live' or 'sandbox'.
# Required: the app throws instead of guessing which account to use.
PADDLE_ENVIRONMENT=live

# Paddle client-side token (Paddle → Developer tools → Authentication).
# Must start with live_ when PADDLE_ENVIRONMENT=live, test_ on sandbox.
# It is public by design and is handed to the browser to open Checkout.
PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxx

# Paddle server-side API key — server only, NEVER referenced in client code.
# Not needed by the pricing page; add it only for webhooks or subscription
# management server functions.
# PADDLE_API_KEY=
